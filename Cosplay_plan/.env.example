# Firebase configuration — copy this file to .env and fill in real values
# Get these values from Firebase Console → Project settings → Your apps → Web app

VITE_FIREBASE_API_KEY=<ใส่ค่าจริง>
VITE_FIREBASE_AUTH_DOMAIN=<ใส่ค่าจริง>
VITE_FIREBASE_PROJECT_ID=<ใส่ค่าจริง>
VITE_FIREBASE_STORAGE_BUCKET=<ใส่ค่าจริง>
VITE_FIREBASE_MESSAGING_SENDER_ID=<ใส่ค่าจริง>
VITE_FIREBASE_APP_ID=<ใส่ค่าจริง>

# ImgBB API key — ใช้อัปโหลดรูปภาพ (แทน Firebase Storage: ฟรี ไม่ต้องใช้บัตร)
# สมัครบัญชีที่ https://imgbb.com/ แล้วเปิด https://api.imgbb.com/ → Get API key
# หมายเหตุ: VITE_ = ฝังอยู่ใน client bundle (คนเห็น key ได้ — ยอมรับแล้ว ดู docs/security-test.md §5)
# หมายเหตุ 2: VITE_FIREBASE_STORAGE_BUCKET แอปไม่ใช้แล้ว (เหลือไว้ให้ scripts/smoke-firebase.mjs)
VITE_IMGBB_API_KEY=<ใส่ค่าจริง>
